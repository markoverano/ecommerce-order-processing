_format_version: "3.0"
_transform: true

# API consumer for JWT authentication on all protected routes.
# Clients must send a JWT signed with HS256 where the `iss` claim equals the key value below.
# Replace the secret with the value of KONG_JWT_SECRET from your .env file before starting.
consumers:
  - username: api-client
    jwt_secrets:
      - key: ecommerce-gateway-key
        algorithm: HS256
        secret: changeme-replace-with-KONG_JWT_SECRET

# Global plugins — applied to every proxied request regardless of route
plugins:
  - name: correlation-id
    config:
      header_name: X-Correlation-ID
      generator: uuid#counter
      echo_downstream: true

services:

  # ── Order Service ────────────────────────────────────────────────────────────
  - name: order-service
    url: http://order-service:8080
    connect_timeout: 10000
    read_timeout: 30000
    write_timeout: 30000
    routes:
      - name: orders-api
        paths:
          - /api/v1/orders
        strip_path: false
        plugins:
          - name: jwt
            config:
              claims_to_verify:
                - exp
              key_claim_name: iss
          - name: rate-limiting
            config:
              minute: 1000
              policy: local
              limit_by: consumer

  # ── Payment Service ──────────────────────────────────────────────────────────
  - name: payment-service
    url: http://payment-service:8080
    connect_timeout: 10000
    read_timeout: 30000
    write_timeout: 30000
    routes:
      - name: payments-api
        paths:
          - /api/v1/payments
        strip_path: false
        plugins:
          - name: jwt
            config:
              claims_to_verify:
                - exp
              key_claim_name: iss
          - name: rate-limiting
            config:
              minute: 1000
              policy: local
              limit_by: consumer
      # Stripe delivers webhooks directly; no JWT, HMAC is verified inside the service
      - name: stripe-webhook
        paths:
          - /api/v1/webhooks/stripe
        methods:
          - POST
        strip_path: false

  # ── Inventory Service ────────────────────────────────────────────────────────
  - name: inventory-service
    url: http://inventory-service:8080
    connect_timeout: 10000
    read_timeout: 30000
    write_timeout: 30000
    routes:
      - name: inventory-api
        paths:
          - /api/v1/inventory
        strip_path: false
        plugins:
          - name: jwt
            config:
              claims_to_verify:
                - exp
              key_claim_name: iss
          - name: rate-limiting
            config:
              minute: 1000
              policy: local
              limit_by: consumer

  # ── Shipping Service ─────────────────────────────────────────────────────────
  - name: shipping-service
    url: http://shipping-service:8080
    connect_timeout: 10000
    read_timeout: 30000
    write_timeout: 30000
    routes:
      - name: shipments-api
        paths:
          - /api/v1/shipments
        strip_path: false
        plugins:
          - name: jwt
            config:
              claims_to_verify:
                - exp
              key_claim_name: iss
          - name: rate-limiting
            config:
              minute: 1000
              policy: local
              limit_by: consumer
      # FedEx delivers webhooks directly; no JWT, HMAC is verified inside the service
      - name: fedex-webhook
        paths:
          - /api/v1/webhooks/fedex
        methods:
          - POST
        strip_path: false

  # ── Notification Service ─────────────────────────────────────────────────────
  - name: notification-service
    url: http://notification-service:8080
    connect_timeout: 10000
    read_timeout: 30000
    write_timeout: 30000
    routes:
      - name: notifications-api
        paths:
          - /api/v1/notifications
        strip_path: false
        plugins:
          - name: jwt
            config:
              claims_to_verify:
                - exp
              key_claim_name: iss
          - name: rate-limiting
            config:
              minute: 1000
              policy: local
              limit_by: consumer
      - name: mailgun-webhook
        paths:
          - /api/v1/webhooks/mailgun
        methods:
          - POST
        strip_path: false
      - name: twilio-webhook
        paths:
          - /api/v1/webhooks/twilio
        methods:
          - POST
        strip_path: false

  # ── Saga Orchestrator ────────────────────────────────────────────────────────
  - name: saga-orchestrator
    url: http://saga-orchestrator:8080
    connect_timeout: 10000
    read_timeout: 30000
    write_timeout: 30000
    routes:
      - name: sagas-api
        paths:
          - /api/v1/sagas
        strip_path: false
        plugins:
          - name: jwt
            config:
              claims_to_verify:
                - exp
              key_claim_name: iss
          - name: rate-limiting
            config:
              minute: 1000
              policy: local
              limit_by: consumer
