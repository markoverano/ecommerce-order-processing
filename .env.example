# PostgreSQL
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=changeme

# RabbitMQ
RABBITMQ_USER=ecommerce
RABBITMQ_PASS=changeme
RABBITMQ_HOST=localhost
RABBITMQ_MGMT_PORT=15672

# Redis
REDIS_CONNECTION_STRING=localhost:6379

# Azure Service Bus (failover broker)
AZURE_SERVICE_BUS_CONNECTION_STRING=

# Stripe (Payment Service)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# FedEx (Shipping Service)
FEDEX_API_KEY=

# Mailgun (Notification Service)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Twilio (Notification Service)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme

# Kong API Gateway
# Copy this value into deploy/kong/kong.yml under consumers[].jwt_secrets[].secret
KONG_JWT_SECRET=changeme-replace-in-production
