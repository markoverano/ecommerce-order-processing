# =============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in real values. NEVER commit .env.
# NEVER use live API keys (sk_live_, pk_live_) in development or CI.
# =============================================================================

# PostgreSQL
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Per-service PostgreSQL passwords (used in init-db.sql)
ORDER_DB_PASSWORD=CHANGE_ME_ORDER_DB_PASSWORD
PAYMENT_DB_PASSWORD=CHANGE_ME_PAYMENT_DB_PASSWORD
INVENTORY_DB_PASSWORD=CHANGE_ME_INVENTORY_DB_PASSWORD
SHIPPING_DB_PASSWORD=CHANGE_ME_SHIPPING_DB_PASSWORD
NOTIFICATION_DB_PASSWORD=CHANGE_ME_NOTIFICATION_DB_PASSWORD
SAGA_DB_PASSWORD=CHANGE_ME_SAGA_DB_PASSWORD

# RabbitMQ
RABBITMQ_USER=ecommerce
RABBITMQ_PASS=CHANGE_ME_STRONG_PASSWORD
RABBITMQ_HOST=localhost
RABBITMQ_MGMT_PORT=15672

# Redis
REDIS_CONNECTION_STRING=localhost:6379

# Azure Service Bus (failover broker)
# For a real namespace: Endpoint=sb://<namespace>.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=<key>
# For the local emulator (docker-compose.asb.yml overlay): replace SAS_KEY_VALUE with the key printed on emulator first start
AZURE_SERVICE_BUS_CONNECTION_STRING=Endpoint=sb://servicebus-emulator;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;

# SQL Server (required only when using the ASB emulator overlay: docker-compose.asb.yml)
MSSQL_SA_PASSWORD=Emulator_Dev_Pass!1

# Stripe (Payment Service)
# WARNING: Never commit sk_live_* or whsec_live_* values. Use test keys only in development.
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_TEST_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_TEST_SECRET

# FedEx (Shipping Service)
FEDEX_API_KEY=

# Mailgun (Notification Service)
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Twilio (Notification Service)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Elasticsearch
# X-Pack security password for the built-in elastic superuser.
# Set a strong value; used by all services that ship logs and by Kibana.
ELASTIC_PASSWORD=CHANGE_ME_STRONG_PASSWORD
ELASTICSEARCH_URI=http://localhost:9200

# Keycloak Identity Provider
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# OIDC authority URL for services; override to point at an external Keycloak instance.
KEYCLOAK_URL=http://localhost:8080/realms/ecommerce

# Kong API Gateway — OIDC plugin
# Generate with: openssl rand -base64 32
# Copy the generated value into deploy/kong/kong.yml under openid-connect plugin client_secret.
# Rotate this value via Keycloak admin console after initial setup.
KEYCLOAK_OIDC_CLIENT_SECRET=CHANGE_ME_REPLACE_WITH_GENERATED_SECRET
